#!/usr/bin/env bash
# MasterFPSOS - pós-instalação COMPLETA (Arch + kernel OGC 7.x)
# Kernel OGC, desktop KDE Plasma com visual MasterFPSOS, tudo em pt-BR,
# jogos, .exe (Proton-GE/Wine), modo gamer, otimização de CPU e GPU.
# Rode como root dentro do sistema instalado:  arch-chroot /mnt masterfps-postinstall
set -uo pipefail
[[ $EUID -eq 0 ]] || { echo "Use o usuário root."; exit 1; }

KEY=F79100EF8C802DAB81C323BB8EEA5962FE510E19
ASC=https://raw.githubusercontent.com/OpenGamingCollective/ogc-arch-packaging/main/ogc.asc
say()  { echo -e "\033[1;32m[MasterFPS]\033[0m $*"; }
warn() { echo -e "\033[1;33m[AVISO]\033[0m $*"; }
pac()  { pacman -S --noconfirm --needed "$@"; }
try()  { pac "$@" || warn "Falhou: $*"; }

# ============================================================ REPOSITÓRIOS
say "Configurando repositórios (multilib + ogc)..."
sed -i '/^#\[multilib\]/{s/^#//;n;s/^#//}' /etc/pacman.conf
grep -q '^\[ogc\]' /etc/pacman.conf || \
  printf '\n[ogc]\nServer = https://pacman.opengamingcollective.org\n' >> /etc/pacman.conf
sed -i 's/^#ParallelDownloads.*/ParallelDownloads = 8/' /etc/pacman.conf
pacman-key --init
pacman-key --populate archlinux
pacman-key --recv-keys "$KEY" 2>/dev/null || curl -fsSL "$ASC" | pacman-key --add -
pacman-key --lsign-key "$KEY"
pacman -Syu --noconfirm

# ================================================================ PT-BR
say "Configurando idioma, teclado e fuso horário (pt-BR)..."
sed -i 's/^#\(pt_BR.UTF-8 UTF-8\)/\1/' /etc/locale.gen
grep -q '^pt_BR.UTF-8' /etc/locale.gen || echo 'pt_BR.UTF-8 UTF-8' >> /etc/locale.gen
locale-gen
echo 'LANG=pt_BR.UTF-8' > /etc/locale.conf
echo 'KEYMAP=br-abnt2' > /etc/vconsole.conf
[[ -e /etc/localtime ]] || ln -sf /usr/share/zoneinfo/America/Sao_Paulo /etc/localtime
hwclock --systohc 2>/dev/null
mkdir -p /etc/X11/xorg.conf.d
cat > /etc/X11/xorg.conf.d/00-keyboard.conf <<'EOF'
Section "InputClass"
    Identifier "teclado-br"
    MatchIsKeyboard "on"
    Option "XkbModel" "abnt2"
    Option "XkbLayout" "br"
EndSection
EOF
cat > /etc/xdg/kxkbrc <<'EOF'
[Layout]
LayoutList=br
Model=abnt2
Use=true
EOF

# ================================================================ KERNEL
say "Instalando o kernel OGC 7.x..."
try linux-ogc linux-ogc-headers linux-firmware pciutils
if grep -qi GenuineIntel /proc/cpuinfo; then try intel-ucode
elif grep -qi AuthenticAMD /proc/cpuinfo; then try amd-ucode; fi

# ======================================================= DRIVER DE VÍDEO
GPU=$(lspci 2>/dev/null | grep -Ei 'vga|3d' || true)
say "Placa de vídeo: ${GPU:-não detectada}"
GPU_KIND=intel
if echo "$GPU" | grep -qi nvidia; then
  GPU_KIND=nvidia
  try nvidia-open-dkms nvidia-utils lib32-nvidia-utils nvidia-settings
  warn "NVIDIA: se o DKMS falhar no kernel 7.x, inicie pelo kernel 'linux' (reserva)."
elif echo "$GPU" | grep -Eqi 'amd|ati|radeon'; then
  GPU_KIND=amd
  try mesa lib32-mesa vulkan-radeon lib32-vulkan-radeon libva-mesa-driver lib32-libva-mesa-driver
else
  try mesa lib32-mesa vulkan-intel lib32-vulkan-intel intel-media-driver
fi

# ======================================= DESKTOP: KDE PLASMA + ÁUDIO + REDE
say "Instalando o desktop KDE Plasma (visual MasterFPSOS)..."
try xorg-server plasma-desktop plasma-nm plasma-pa plasma-systemmonitor kscreen \
    powerdevil sddm sddm-kcm kde-gtk-config breeze-gtk xdg-desktop-portal-kde \
    qt6-wayland konsole dolphin ark gwenview spectacle kate \
    networkmanager firefox firefox-i18n-pt-br hunspell-pt-br man-pages-pt_br \
    pipewire pipewire-pulse pipewire-alsa lib32-pipewire wireplumber \
    papirus-icon-theme inter-font librsvg qt6-svg noto-fonts noto-fonts-emoji ttf-liberation \
    xdg-utils shared-mime-info git base-devel htop flatpak sudo earlyoom zram-generator

# ============================================== JOGOS + WINDOWS (.exe)
say "Instalando Steam, Wine-Staging, Proton (umu), GameMode, MangoHud, Gamescope..."
try steam lutris gamemode lib32-gamemode mangohud lib32-mangohud vulkan-tools \
    wine-staging wine-mono wine-gecko winetricks vkd3d lib32-vkd3d \
    lib32-gnutls lib32-libpulse lib32-alsa-plugins lib32-openal lib32-sdl2 \
    lib32-libxcomposite lib32-libxinerama lib32-giflib lib32-v4l-utils
try umu-launcher
try gamescope-ogc gamescope-session-steam
try scx-scheds

