cat > /usr/local/bin/masterfps-boost <<'EOF'
#!/usr/bin/env bash
# masterfps-boost on|off|status — Modo Gamer: CPU e GPU em desempenho máximo
STATE=/run/masterfps-boost.state
[[ $EUID -eq 0 ]] || { echo "Use: sudo masterfps-boost on|off|status"; exit 1; }
CPU=/sys/devices/system/cpu
case "${1:-status}" in
  on)
    if [[ ! -f $STATE ]]; then
      printf '%s\n%s\n' "$(cat $CPU/cpu0/cpufreq/scaling_governor 2>/dev/null)" \
        "$(cat $CPU/cpu0/cpufreq/energy_performance_preference 2>/dev/null)" > $STATE
    fi
    [[ -w $CPU/cpufreq/boost ]] && echo 1 > $CPU/cpufreq/boost
    [[ -w $CPU/intel_pstate/no_turbo ]] && echo 0 > $CPU/intel_pstate/no_turbo
    for p in $CPU/cpu*/cpufreq; do
      echo performance > "$p/scaling_governor" 2>/dev/null
      [[ -w $p/energy_performance_preference ]] && echo performance > "$p/energy_performance_preference" 2>/dev/null
      [[ -r $p/cpuinfo_max_freq && -w $p/scaling_min_freq ]] && cat "$p/cpuinfo_max_freq" > "$p/scaling_min_freq" 2>/dev/null
    done
    for d in /sys/class/drm/card?/device; do
      [[ "$(cat $d/vendor 2>/dev/null)" == 0x1002 && -w $d/power_dpm_force_performance_level ]] \
        && echo high > "$d/power_dpm_force_performance_level"
    done
    command -v nvidia-smi >/dev/null && nvidia-smi -pm 1 >/dev/null 2>&1
    sysctl -q kernel.split_lock_mitigate=0 2>/dev/null
    systemctl start masterfps-lowlat.service 2>/dev/null
    echo "MODO GAMER: ATIVADO (CPU e GPU em desempenho máximo, latência mínima)" ;;
  off)
    gov=schedutil; epp=balance_performance
    if [[ -f $STATE ]]; then gov=$(sed -n 1p $STATE); epp=$(sed -n 2p $STATE); fi
    [[ "$gov" == performance || -z "$gov" ]] && gov=schedutil
    systemctl stop masterfps-lowlat.service 2>/dev/null
    for p in $CPU/cpu*/cpufreq; do
      [[ -r $p/cpuinfo_min_freq && -w $p/scaling_min_freq ]] && cat "$p/cpuinfo_min_freq" > "$p/scaling_min_freq" 2>/dev/null
      echo "$gov" > "$p/scaling_governor" 2>/dev/null || echo powersave > "$p/scaling_governor" 2>/dev/null
      [[ -n "$epp" && -w $p/energy_performance_preference ]] && echo "$epp" > "$p/energy_performance_preference" 2>/dev/null
    done
    for d in /sys/class/drm/card?/device; do
      [[ -w $d/power_dpm_force_performance_level ]] && echo auto > "$d/power_dpm_force_performance_level"
    done
    rm -f $STATE
    echo "MODO GAMER: DESATIVADO (modo equilibrado / economia)" ;;
  status)
    echo "CPU governor   : $(cat $CPU/cpu0/cpufreq/scaling_governor 2>/dev/null)"
    echo "CPU preferência: $(cat $CPU/cpu0/cpufreq/energy_performance_preference 2>/dev/null)"
    echo "CPU freq mín   : $(cat $CPU/cpu0/cpufreq/scaling_min_freq 2>/dev/null) kHz"
    echo "Latência baixa : $(systemctl is-active masterfps-lowlat.service 2>/dev/null)"
    for d in /sys/class/drm/card?/device; do
      [[ -r $d/power_dpm_force_performance_level ]] && echo "GPU AMD        : $(cat $d/power_dpm_force_performance_level)"
    done
    echo "Kernel         : $(uname -r)" ;;
  *) echo "Uso: masterfps-boost on|off|status"; exit 1 ;;
esac
EOF

