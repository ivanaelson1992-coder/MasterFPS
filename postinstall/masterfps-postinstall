# ----------------------------------------------------- EXECUTAR .EXE / .MSI
cat > /usr/local/bin/masterfps-run <<'EOF'
#!/usr/bin/env bash
# masterfps-run arquivo.exe [args] — executa programas e jogos do Windows
# Usa umu-launcher (Proton-GE) quando disponível; senão, Wine.
f="${1:-}"
[[ -n "$f" ]] || { echo "Uso: masterfps-run arquivo.exe [argumentos]"; exit 1; }
shift
f=$(readlink -f -- "$f")
cd "$(dirname "$f")" || exit 1

export WINEPREFIX="${WINEPREFIX:-$HOME/.masterfps/prefix}"
export WINEDEBUG=-all DXVK_LOG_LEVEL=none VKD3D_DEBUG=none
export PROTON_USE_NTSYNC=1 WINEESYNC=1 WINEFSYNC=1
export mesa_glthread=true __GL_THREADED_OPTIMIZATIONS=1
mkdir -p "$WINEPREFIX"

RUN=()
command -v gamemoderun >/dev/null && RUN+=(gamemoderun)
[[ "${MASTERFPS_HUD:-0}" == 1 ]] && command -v mangohud >/dev/null && RUN+=(mangohud)

case "${f,,}" in
  *.msi)         CMD=(msiexec /i "$f" "$@") ;;
  *.bat|*.cmd)   CMD=(cmd /c "$f" "$@") ;;
  *)             CMD=("$f" "$@") ;;
esac

if command -v umu-run >/dev/null; then
  export GAMEID="${GAMEID:-umu-default}" PROTONPATH="${PROTONPATH:-GE-Proton}"
  exec "${RUN[@]}" umu-run "${CMD[@]}"
else
  exec "${RUN[@]}" wine "${CMD[@]}"
fi
EOF

