cat > /usr/local/bin/masterfps-apps <<'EOF'
#!/usr/bin/env bash
# Instala Bottles, ProtonUp-Qt e Heroic (Epic/GOG) via Flatpak (usuário)
flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
