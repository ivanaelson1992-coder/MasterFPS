EOF
chmod +x /usr/local/bin/masterfps-{boost,run,apps,lowlat}
update-desktop-database /usr/share/applications 2>/dev/null

# ================================================== IDENTIDADE: MasterFPSOS
say "Aplicando a identidade MasterFPSOS (os-release, hostname, login)..."
cat > /usr/lib/os-release <<'EOF'
NAME="MasterFPSOS"
PRETTY_NAME="MasterFPSOS"
ID=masterfpsos
ID_LIKE=arch
BUILD_ID=rolling
ANSI_COLOR="38;2;255;138;30"
HOME_URL="https://github.com/OpenGamingCollective"
EOF
cat > /etc/lsb-release <<'EOF'
DISTRIB_ID="MasterFPSOS"
DISTRIB_RELEASE="rolling"
DISTRIB_DESCRIPTION="MasterFPSOS"
EOF
printf 'MasterFPSOS \\r (\\l)\n\n' > /etc/issue
grep -q '^NoUpgrade.*os-release' /etc/pacman.conf || \
  sed -i '/^\[options\]/a NoUpgrade = usr/lib/os-release etc/lsb-release etc/issue' /etc/pacman.conf
echo masterfpsos > /etc/hostname
grep -q masterfpsos /etc/hosts 2>/dev/null || echo '127.0.1.1 masterfpsos.localdomain masterfpsos' >> /etc/hosts

# ================================================================ SERVIÇOS
systemctl enable sddm NetworkManager masterfps-boost.service fstrim.timer earlyoom.service 2>/dev/null
systemctl enable scx.service 2>/dev/null || warn "scx.service indisponível (normal se o kernel não tiver sched_ext)"

# =============================================================== BOOTLOADER
PARAMS="nowatchdog threadirqs preempt=full"
if command -v grub-mkconfig >/dev/null 2>&1 && [[ -f /etc/default/grub ]]; then
  say "Ajustando o GRUB (nome MasterFPSOS + fênix)..."
  setg() { if grep -q "^$1=" /etc/default/grub; then sed -i "s|^$1=.*|$1=$2|" /etc/default/grub; else echo "$1=$2" >> /etc/default/grub; fi; }
  grep -q nowatchdog /etc/default/grub || \
    sed -i "s/^\(GRUB_CMDLINE_LINUX_DEFAULT=\"[^\"]*\)\"/\1 $PARAMS\"/" /etc/default/grub
  setg GRUB_DISTRIBUTOR '"MasterFPSOS"'
  setg GRUB_GFXMODE auto
  setg GRUB_GFXPAYLOAD_LINUX keep
  setg GRUB_COLOR_NORMAL '"light-gray/black"'
  setg GRUB_COLOR_HIGHLIGHT '"black/yellow"'
  if command -v rsvg-convert >/dev/null 2>&1 && \
     rsvg-convert -w 1920 -h 1080 /usr/share/masterfps/fenix.svg -o /boot/grub/masterfpsos.png; then
    setg GRUB_BACKGROUND '"/boot/grub/masterfpsos.png"'
  else
    warn "Não consegui gerar o fundo do GRUB (rsvg-convert)."
  fi
  if [[ -t 0 ]]; then
    read -rp "Desativar as mitigações de CPU (mitigations=off)? Mais FPS, MENOS segurança. [s/N] " r
    if [[ "${r,,}" == s ]]; then
      grep -q 'mitigations=off' /etc/default/grub || \
        sed -i 's/^\(GRUB_CMDLINE_LINUX_DEFAULT="[^"]*\)"/\1 mitigations=off"/' /etc/default/grub
    fi
  fi
  grub-mkconfig -o /boot/grub/grub.cfg
elif [[ -d /boot/loader/entries ]]; then
  say "Criando entradas do systemd-boot (MasterFPSOS)..."
  for f in /boot/loader/entries/*linux.conf; do
    [[ -f "$f" ]] || continue
    sed -e 's/vmlinuz-linux/vmlinuz-linux-ogc/' \
        -e 's/initramfs-linux\.img/initramfs-linux-ogc.img/' \
        -e 's/^title.*/title MasterFPSOS/' \
        -e "/^options/ s/\$/ $PARAMS/" "$f" > "${f%linux.conf}linux-ogc.conf"
    sed -i 's/^title.*/title MasterFPSOS (kernel padrão)/' "$f"
  done
  for f in /boot/loader/entries/*fallback.conf; do
    [[ -f "$f" ]] && sed -i 's/^title.*/title MasterFPSOS (recuperação)/' "$f"
  done
  grep -q '^default' /boot/loader/loader.conf \
    && sed -i 's/^default.*/default *ogc*/' /boot/loader/loader.conf \
    || echo 'default *ogc*' >> /boot/loader/loader.conf
else
  warn "Bootloader não detectado: aponte-o para /boot/vmlinuz-linux-ogc manualmente."
fi

mkinitcpio -P 2>/dev/null

say "PRONTO! Reinicie o computador."
echo "  - Confira o kernel:    uname -r   (deve conter 'ogc')"
echo "  - Abrir .exe:          dois cliques no arquivo, ou:  masterfps-run jogo.exe"
echo "  - Modo Gamer:          sudo masterfps-boost on|off|status"
echo "  - Apps extras:         masterfps-apps   (Bottles, ProtonUp-Qt, Heroic)"
echo "  - Opções da Steam:     gamemoderun mangohud %command%"
