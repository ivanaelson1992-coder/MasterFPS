import QtQuick 2.15
import QtQuick.Controls 2.15

Rectangle {
    id: root
    width: 1920
    height: 1080
    color: "#05060c"
    property int sessionIndex: (sessionModel.lastIndex >= 0) ? sessionModel.lastIndex : 0

    function doLogin() {
        errorText.text = ""
        sddm.login(userField.text, passField.text, root.sessionIndex)
    }

    Image {
        anchors.fill: parent
        source: "background.svg"
        fillMode: Image.PreserveAspectCrop
    }

    Rectangle {
        id: card
        width: 400
        height: 400
        radius: 26
        color: "#D9100B10"
        border.color: "#66FF8A1E"
        border.width: 1
        x: Math.min(parent.width - width - 40, parent.width * 0.74 - width / 2)
        anchors.verticalCenter: parent.verticalCenter

        Column {
            anchors.centerIn: parent
            spacing: 14
            width: parent.width - 64

            Text {
                text: "MasterFPSOS"
                color: "#FFB020"
                font.pixelSize: 34
                font.bold: true
                anchors.horizontalCenter: parent.horizontalCenter
            }
            Text {
                id: clock
                color: "#FFD9A0"
                font.pixelSize: 15
                anchors.horizontalCenter: parent.horizontalCenter
                text: Qt.formatDateTime(new Date(), "HH:mm  •  dd/MM/yyyy")
                Timer {
                    interval: 1000; running: true; repeat: true
                    onTriggered: clock.text = Qt.formatDateTime(new Date(), "HH:mm  •  dd/MM/yyyy")
                }
            }
            Item { width: 1; height: 6 }

            TextField {
                id: userField
                width: parent.width
                placeholderText: "Usuário"
                text: userModel.lastUser
                color: "white"
                font.pixelSize: 16
                background: Rectangle { radius: 12; color: "#33FFFFFF"; border.color: userField.activeFocus ? "#FF8A1E" : "#44FFFFFF" }
                onAccepted: passField.forceActiveFocus()
            }
            TextField {
                id: passField
                width: parent.width
                placeholderText: "Senha"
                echoMode: TextInput.Password
                color: "white"
                font.pixelSize: 16
                background: Rectangle { radius: 12; color: "#33FFFFFF"; border.color: passField.activeFocus ? "#FF8A1E" : "#44FFFFFF" }
                onAccepted: root.doLogin()
            }
            Text {
                id: errorText
                color: "#FF6A4D"
                font.pixelSize: 14
                anchors.horizontalCenter: parent.horizontalCenter
                text: ""
            }
            Button {
                width: parent.width
                text: "Entrar"
                font.pixelSize: 17
                font.bold: true
                contentItem: Text { text: parent.text; color: "#1A0A00"; font: parent.font; horizontalAlignment: Text.AlignHCenter; verticalAlignment: Text.AlignVCenter }
                background: Rectangle { radius: 12; color: parent.down ? "#E07000" : "#FF9A1A" }
                onClicked: root.doLogin()
            }
            Row {
                spacing: 12
                anchors.horizontalCenter: parent.horizontalCenter
                Button {
                    text: "Reiniciar"
                    onClicked: sddm.reboot()
                }
                Button {
                    text: "Desligar"
                    onClicked: sddm.powerOff()
                }
            }
        }
    }

    Connections {
        target: sddm
        function onLoginFailed() {
            errorText.text = "Usuário ou senha incorretos"
            passField.text = ""
            passField.forceActiveFocus()
        }
    }

    Component.onCompleted: passField.forceActiveFocus()
}
EOF

