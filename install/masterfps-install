#!/usr/bin/env bash
# MasterFPSOS - instalador automatico (roda na ISO live)
# ATENÇÃO: apaga TODO o conteúdo do disco escolhido.
set -uo pipefail
[[ $EUID -eq 0 ]] || { echo "Use como root."; exit 1; }

say()  { printf '\033[1;32m[MasterFPSOS]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[AVISO]\033[0m %s\n' "$*"; }

press_enter() { read -r -p "Pressione Enter para continuar..." _; }

abort() {
  warn "$*"
  umount -R /mnt >/dev/null 2>&1 || true
  press_enter
  return 1
}

main_menu() {
  while true; do
    clear
    cat <<'BANNER'
================================================
   MasterFPSOS  -  Instalador
================================================
BANNER
    echo
    echo "  i) Instalar o MasterFPSOS (apaga o disco inteiro)"
    echo "  a) Instalador avançado (archinstall)"
    echo "  s) Usar o terminal (modo live)"
    echo "  r) Reiniciar o computador"
    echo
    local c
    read -r -p "Escolha [i]: " c
    case "${c,,}" in
      ""|i) run_install ;;
      a) clear; say "Abrindo o archinstall (modo avançado)..."; archinstall ;;
      s) return 0 ;;
      r) reboot ;;
      *) warn "Opção inválida."; press_enter ;;
    esac
  done
}

run_install() {
  clear
  say "Verificando conexão com a internet..."
  if ! curl -fsI --max-time 8 https://archlinux.org >/dev/null 2>&1; then
    warn "Sem internet. Configure a rede (ex.: nmtui) e tente de novo."
    press_enter; return
  fi

  echo
  echo "Discos disponíveis:"
  lsblk -d -n -o NAME,SIZE,MODEL,TRAN 2>/dev/null | grep -Ev '^(loop|sr|zram)'
  echo
  local disk
  read -r -p "Digite o nome do disco (ex.: sda, nvme0n1): " disk
  disk="${disk#/dev/}"
  if [[ ! -b "/dev/$disk" || "$disk" == loop* || "$disk" == sr* || "$disk" == zram* ]]; then
    warn "Disco '/dev/$disk' inválido."; press_enter; return
  fi

  local uefi=0
  [[ -d /sys/firmware/efi ]] && uefi=1

  echo
  warn "ISSO APAGA TUDO em /dev/$disk ($(lsblk -d -n -o SIZE "/dev/$disk" | tr -d ' '))!"
  local conf
  read -r -p "Para confirmar, digite o nome do disco novamente: " conf
  if [[ "$conf" != "$disk" ]]; then
    warn "Confirmação não confere. Abortando."; press_enter; return
  fi

  local user
  while true; do
    read -r -p "Nome do usuário (letras minúsculas): " user
    [[ "$user" =~ ^[a-z_][a-z0-9_-]*$ ]] && break
    warn "Nome inválido. Use letras minúsculas, números, - ou _."
  done

  local pass pass2
  while true; do
    read -r -s -p "Senha do usuário: " pass; echo
    read -r -s -p "Repita a senha: " pass2; echo
    [[ -n "$pass" && "$pass" == "$pass2" ]] && break
    warn "Senhas vazias ou não conferem."
  done

  local rootpw=""
  read -r -s -p "Senha do root (Enter = bloquear root, usar sudo): " rootpw; echo

  echo
  say "Apagando e particionando /dev/$disk ($( [[ $uefi -eq 1 ]] && echo UEFI || echo BIOS ))..."
  wipefs -a "/dev/$disk" >/dev/null 2>&1 || true
  if [[ $uefi -eq 1 ]]; then
    sgdisk -Zo "/dev/$disk" >/dev/null || { abort "Falha ao particionar."; return; }
    sgdisk -n1:0:+1G -t1:ef00 "/dev/$disk" >/dev/null
    sgdisk -n2:0:0   -t2:8300 "/dev/$disk" >/dev/null
  else
    sgdisk -Zo "/dev/$disk" >/dev/null || { abort "Falha ao particionar."; return; }
    sgdisk -n1:0:+1M -t1:ef02 "/dev/$disk" >/dev/null
    sgdisk -n2:0:0   -t2:8300 "/dev/$disk" >/dev/null
  fi
  partprobe "/dev/$disk" >/dev/null 2>&1 || true
  sleep 1

  local parts=()
  mapfile -t parts < <(lsblk -n -o NAME "/dev/$disk" | sed 1d)
  if [[ ${#parts[@]} -lt 2 ]]; then
    abort "Não encontrei as partições criadas."; return
  fi
  local rootpart="/dev/${parts[1]}"
  local esp=""
  [[ $uefi -eq 1 ]] && esp="/dev/${parts[0]}"

  say "Formatando as partições..."
  [[ $uefi -eq 1 ]] && mkfs.fat -F32 -n EFIBOOT "$esp" >/dev/null
  mkfs.ext4 -q -F -L MasterFPSOS "$rootpart" >/dev/null || { abort "Falha ao formatar."; return; }

  say "Instalando o sistema base (pode demorar alguns minutos)..."
  mount "$rootpart" /mnt || { abort "Falha ao montar."; return; }
  if [[ $uefi -eq 1 ]]; then
    mkdir -p /mnt/boot/efi
    mount "$esp" /mnt/boot/efi || { abort "Falha ao montar a EFI."; return; }
  fi
  if ! pacstrap -K /mnt base linux-ogc linux-ogc-headers linux-firmware grub efibootmgr sudo; then
    abort "Falha ao instalar os pacotes base (rede ou repositório)."; return
  fi
  genfstab -U /mnt >> /mnt/etc/fstab

  say "Configurando idioma, fuso, usuário e bootloader..."
  cat > /mnt/root/.mf-setup.sh <<'EOF'
set -e
ln -sf /usr/share/zoneinfo/America/Sao_Paulo /etc/localtime
hwclock --systohc
sed -i 's/^#\(pt_BR.UTF-8 UTF-8\)/\1/' /etc/locale.gen
locale-gen
echo 'LANG=pt_BR.UTF-8' > /etc/locale.conf
echo 'KEYMAP=br-abnt2' > /etc/vconsole.conf
echo masterfpsos > /etc/hostname
grep -q masterfpsos /etc/hosts || echo '127.0.1.1 masterfpsos.localdomain masterfpsos' >> /etc/hosts
if [ -n "$MF_ROOTPASS" ]; then
  echo "root:$MF_ROOTPASS" | chpasswd
else
  passwd -l root
fi
id "$MF_USER" >/dev/null 2>&1 || useradd -m -G wheel -s /bin/bash "$MF_USER"
echo "$MF_USER:$MF_PASS" | chpasswd
echo '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/wheel
chmod 440 /etc/sudoers.d/wheel
EOF
  if ! MF_USER="$user" MF_PASS="$pass" MF_ROOTPASS="$rootpw" arch-chroot /mnt bash /root/.mf-setup.sh; then
    abort "Falha na configuração inicial."; return
  fi
  rm -f /mnt/root/.mf-setup.sh

  if [[ $uefi -eq 1 ]]; then
    arch-chroot /mnt grub-install --target=x86_64-efi --efi-directory=/boot/efi --bootloader-id=MasterFPSOS \
      || { abort "Falha ao instalar o GRUB (UEFI)."; return; }
  else
    arch-chroot /mnt grub-install --target=i386-pc "/dev/$disk" \
      || { abort "Falha ao instalar o GRUB (BIOS)."; return; }
  fi

  say "Pós-instalação completa (KDE, Steam, Wine/Proton, modo gamer, tema MasterFPSOS)..."
  warn "Esta etapa é longa. Se aparecerem linhas '[AVISO] Falhou', anote os pacotes."
  cp /usr/local/bin/masterfps-postinstall /mnt/usr/local/bin/
  arch-chroot /mnt masterfps-postinstall

  umount -R /mnt
  say "Instalação concluída! Retire a ISO do drive e reinicie."
  local r
  read -r -p "Reiniciar agora? [s/N]: " r
  [[ "${r,,}" == s ]] && reboot
}

main_menu "$@"
